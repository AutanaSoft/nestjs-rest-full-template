// User roles
enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  MODERATOR
  SUPPORT
  USER
  GUEST
}

// User Status
enum UserStatus {
  REGISTERED
  ACTIVE
  SUSPENDED
  BANNED
}

model UserDbEntity {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @db.VarChar(255)
  emailHash       String     @unique @map("email_hash") @db.VarChar(64)
  userName        String     @unique @map("user_name") @db.VarChar(20)
  password        String     @db.VarChar(64)
  status          UserStatus @default(REGISTERED)
  role            UserRole   @default(USER)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz()
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  /// Relaciones
  sessions    UserSessionDbEntity[]
  permissions UserPermissionDbEntity[]

  @@index([emailHash])
  @@index([userName])
  @@index([createdAt])
  @@map("users")
}
